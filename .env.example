# Development only: save messages locally instead of sending email.
MAIL_DELIVERY=file
APP_BASE_URL=http://localhost:9292

# Real delivery: remove MAIL_DELIVERY=file and configure a verified sender.
RESEND_API_KEY=
MAIL_FROM=

# Production also requires RACK_ENV=production, an HTTPS APP_BASE_URL,
# and a random SESSION_SECRET of at least 64 characters.
SESSION_SECRET=
